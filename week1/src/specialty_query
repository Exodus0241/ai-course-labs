"""
Специализированный инструмент для дипломной работы.

Инструмент анализирует дефекты закупорки молочной тары и формирует
прикладной отчёт с помощью LLM. Внутри остаётся простая Python-логика
для подготовки структуры данных, а итоговые выводы и рекомендации
генерируются моделью.
"""

from __future__ import annotations

import logging
import os
from typing import Any, Dict, List, Optional, Type

from langchain.tools import BaseTool
from langchain_community.chat_models import ChatYandexGPT
from langchain_core.language_models.base import BaseLanguageModel
from langchain_core.messages import AIMessage, BaseMessage
from pydantic import BaseModel, Field, PrivateAttr

logger = logging.getLogger(__name__)


class CustomToolInput(BaseModel):
    """Схема входных параметров для анализа дефекта."""

    defect_type: str = Field(
        description=(
            "Тип дефекта закупорки: 'недозатяжка', 'перекос', "
            "'повреждение_резьбы', 'нарушение_герметичности', 'отсутствие_крышки'"
        ),
        min_length=1,
        max_length=50,
    )
    production_line_id: str = Field(
        description="Идентификатор производственной линии, например LINE_01",
        default="LINE_01",
    )
    time_range_hours: int = Field(
        description="Временной диапазон анализа в часах",
        default=24,
        ge=1,
        le=168,
    )
    include_statistics: bool = Field(
        description="Нужно ли включать статистический блок в вывод",
        default=True,
    )


class CustomTool(BaseTool):
    """Инструмент анализа дефектов закупорки с использованием LLM."""

    name: str = "defect_analysis_tool"
    description: str = (
        "Анализирует дефекты закупорки молочной тары на производственной линии "
        "и формирует инженерный отчёт с использованием LLM."
    )
    args_schema: Type[BaseModel] = CustomToolInput

    _llm: Optional[BaseLanguageModel] = PrivateAttr(default=None)
    _defect_database: Dict[str, Dict[str, Dict[str, Any]]] = PrivateAttr(
        default_factory=lambda: {
            "LINE_01": {
                "недозатяжка": {"count": 47, "trend": "stable", "critical_threshold": 50},
                "перекос": {"count": 23, "trend": "decreasing", "critical_threshold": 30},
                "повреждение_резьбы": {"count": 12, "trend": "increasing", "critical_threshold": 15},
                "нарушение_герметичности": {
                    "count": 31,
                    "trend": "critical",
                    "critical_threshold": 25,
                },
                "отсутствие_крышки": {"count": 8, "trend": "stable", "critical_threshold": 10},
            },
            "LINE_02": {
                "недозатяжка": {"count": 35, "trend": "decreasing", "critical_threshold": 50},
                "перекос": {"count": 18, "trend": "stable", "critical_threshold": 30},
                "повреждение_резьбы": {"count": 9, "trend": "stable", "critical_threshold": 15},
                "нарушение_герметичности": {"count": 22, "trend": "stable", "critical_threshold": 25},
                "отсутствие_крышки": {"count": 5, "trend": "stable", "critical_threshold": 10},
            },
        }
    )

    def __init__(self, llm: BaseLanguageModel | None = None, **kwargs: Any) -> None:
        super().__init__(**kwargs)
        self._llm = llm or self._build_llm_from_env()

    def _build_llm_from_env(self) -> BaseLanguageModel | None:
        """Создаёт YandexGPT из переменных окружения, если они доступны."""
        raw_api_key = os.getenv("YC_API_KEY")
        iam_token = os.getenv("YC_IAM_TOKEN") or os.getenv("YANDEX_IAM_TOKEN")
        folder_id = os.getenv("YC_FOLDER_ID") or os.getenv("YANDEX_FOLDER_ID")
        model_name = os.getenv("YC_MODEL_NAME", "yandexgpt-lite")
        model_version = os.getenv("YC_MODEL_VERSION", "latest")
        disable_logging = os.getenv("YC_DISABLE_LOGGING", "false").lower() == "true"
        api_key = raw_api_key

        if raw_api_key and raw_api_key.startswith("t1."):
            iam_token = raw_api_key
            api_key = None

        if not folder_id or not (api_key or iam_token):
            return None

        llm_kwargs: Dict[str, Any] = {
            "folder_id": folder_id,
            "model_name": model_name,
            "model_version": model_version,
            "temperature": 0,
            "disable_request_logging": disable_logging,
        }
        if api_key:
            llm_kwargs["api_key"] = api_key
        else:
            llm_kwargs["iam_token"] = iam_token
        return ChatYandexGPT(**llm_kwargs)

    def _run(
        self,
        defect_type: str,
        production_line_id: str = "LINE_01",
        time_range_hours: int = 24,
        include_statistics: bool = True,
    ) -> str:
        """Выполняет анализ дефекта и передаёт контекст в модель."""
        logger.info(
            "Анализ дефектов: тип=%s, линия=%s, период=%sч",
            defect_type,
            production_line_id,
            time_range_hours,
        )

        defect_data = self._get_defect_data(defect_type, production_line_id, time_range_hours)
        analytics = self._build_analytics_payload(defect_data, include_statistics)

        if self._llm is None:
            return (
                "LLM не настроена. Передайте YC_API_KEY или YC_IAM_TOKEN и YC_FOLDER_ID, "
                "чтобы инструмент формировал ответ через модель."
            )

        prompt = self._build_prompt(analytics)
        try:
            response = self._llm.invoke(prompt)
            return self._normalize_response(response)
        except Exception as error:
            logger.error("Ошибка при обращении к LLM: %s", error, exc_info=True)
            return f"Ошибка обращения к модели: {error}"

    async def _arun(
        self,
        defect_type: str,
        production_line_id: str = "LINE_01",
        time_range_hours: int = 24,
        include_statistics: bool = True,
    ) -> str:
        return self._run(defect_type, production_line_id, time_range_hours, include_statistics)

    def to_langchain_tool(self) -> BaseTool:
        """Возвращает инструмент в формате LangChain."""
        return self

    def _get_defect_data(self, defect_type: str, line_id: str, hours: int) -> Dict[str, Any]:
        """Возвращает структурированные данные о дефекте."""
        line_data = self._defect_database.get(line_id, {})
        defect_data = line_data.get(
            defect_type,
            {"count": 0, "trend": "unknown", "critical_threshold": 0},
        )

        scale_factor = min(hours / 24, 1.0)
        scaled_count = int(defect_data["count"] * scale_factor)
        total_production = int(10000 * scale_factor)
        defect_rate = round((scaled_count / total_production * 100) if total_production else 0.0, 2)

        return {
            "line_id": line_id,
            "defect_type": defect_type,
            "count": scaled_count,
            "trend": defect_data["trend"],
            "threshold": defect_data["critical_threshold"],
            "period_hours": hours,
            "total_production": total_production,
            "defect_rate": defect_rate,
        }

    def _build_analytics_payload(self, data: Dict[str, Any], include_stats: bool) -> Dict[str, Any]:
        """Готовит аналитический контекст для LLM."""
        payload: Dict[str, Any] = {
            "summary": {
                "line_id": data["line_id"],
                "defect_type": data["defect_type"],
                "period_hours": data["period_hours"],
                "count": data["count"],
                "total_production": data["total_production"],
                "defect_rate": data["defect_rate"],
                "trend": data["trend"],
                "threshold": data["threshold"],
                "status": self._get_status(data["count"], data["threshold"]),
            },
            "recommendations": self._get_recommendations(data),
        }

        if include_stats:
            payload["statistics"] = {
                "deviation_from_norm_percent": self._calculate_deviation(data["defect_rate"]),
                "variation": self._calculate_variation(data["count"]),
            }

        return payload

    def _build_prompt(self, analytics: Dict[str, Any]) -> str:
        """Формирует инженерный промпт для модели."""
        return (
            "Ты эксперт по качеству на линии розлива молочной продукции и помогаешь "
            "готовить материалы для дипломной работы по теме информационной системы "
            "контроля дефектов закупорки молочной тары.\n\n"
            "Ниже переданы структурированные данные анализа дефекта в JSON.\n"
            "Сформируй профессиональный отчёт на русском языке.\n"
            "Не выдумывай исходные числа сверх переданных данных.\n"
            "Структура ответа:\n"
            "1. Краткий вывод по ситуации.\n"
            "2. Интерпретация уровня риска.\n"
            "3. Вероятные технологические причины.\n"
            "4. Практические рекомендации оператору и инженеру.\n"
            "5. Что должна сохранить информационная система.\n"
            "6. Какие графики или показатели показать в дипломе.\n\n"
            f"Данные анализа:\n{analytics}"
        )

    def _normalize_response(self, response: str | BaseMessage) -> str:
        """Преобразует ответ модели в обычный текст."""
        if isinstance(response, AIMessage):
            return str(response.content)
        if isinstance(response, BaseMessage):
            return str(response.content)
        return str(response)

    def _get_status(self, count: int, threshold: int) -> str:
        """Возвращает оценку критичности."""
        if threshold == 0:
            return "unknown"
        if count >= threshold:
            return "critical"
        if count >= threshold * 0.8:
            return "warning"
        return "normal"

    def _calculate_deviation(self, defect_rate: float) -> float:
        """Расчёт отклонения от условной нормы 0.5%."""
        norm = 0.5
        deviation = ((defect_rate - norm) / norm * 100) if norm > 0 else 0
        return round(deviation, 1)

    def _calculate_variation(self, count: int) -> str:
        """Упрощённая оценка устойчивости процесса."""
        if count < 10:
            return "high"
        if count < 30:
            return "medium"
        return "low"

    def _get_recommendations(self, data: Dict[str, Any]) -> List[str]:
        """Базовые предметные рекомендации для передачи модели."""
        recommendations: List[str] = []

        defect_type = data["defect_type"]
        trend = data["trend"]
        rate = data["defect_rate"]

        if defect_type == "недозатяжка":
            recommendations.extend(
                [
                    "Проверить момент затяжки на закупорочной головке",
                    "Проверить износ уплотнительных элементов",
                ]
            )
        elif defect_type == "перекос":
            recommendations.extend(
                [
                    "Проверить центрирование тары и крышки",
                    "Проконтролировать параллельность закупорочной головки",
                ]
            )
        elif defect_type == "повреждение_резьбы":
            recommendations.extend(
                [
                    "Проверить состояние резьбового узла",
                    "Оценить качество поставляемых крышек",
                ]
            )
        elif defect_type == "нарушение_герметичности":
            recommendations.extend(
                [
                    "Провести тест герметичности",
                    "Проверить чистоту горловины тары и посадку крышки",
                ]
            )
        elif defect_type == "отсутствие_крышки":
            recommendations.extend(
                [
                    "Проверить питатель крышек",
                    "Проверить датчик наличия крышки на линии",
                ]
            )

        if trend == "increasing":
            recommendations.append("Провести внеплановое техническое обслуживание")
        if trend == "critical":
            recommendations.append("Провести срочную диагностику оборудования")
        if rate > 1.0:
            recommendations.append("Усилить контроль партии и уведомить ответственную смену")

        return recommendations[:5]


if __name__ == "__main__":
    from dotenv import load_dotenv

    logging.basicConfig(level=logging.INFO)
    load_dotenv()

    tool = CustomTool()

    test_cases = [
        ("нарушение_герметичности", "LINE_01", 24, True),
        ("недозатяжка", "LINE_02", 48, True),
        ("перекос", "LINE_01", 12, True),
    ]

    for defect, line, hours, stats in test_cases:
        result = tool.invoke(
            {
                "defect_type": defect,
                "production_line_id": line,
                "time_range_hours": hours,
                "include_statistics": stats,
            }
        )
        print(result)
        print()
